# Template only: replace domain/certificate paths. Do not expose Next directly.
server {
    listen 80;
    server_name salon.example;
    if ($host != salon.example) { return 444; }
    return 301 https://salon.example$request_uri;
}
server {
    listen 443 ssl;
    server_name salon.example;
    ssl_certificate /etc/letsencrypt/live/salon.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/salon.example/privkey.pem;
    if ($host != salon.example) { return 444; }
    client_max_body_size 256k;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
    }
}
