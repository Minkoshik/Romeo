# Демонстрационные параметры Docker. Не используйте пароль в production.
# Windows portable: scripts/start-local-db.ps1 создаёт защищённую .env
# со случайными паролями и локальным портом начиная с 5433.
DATABASE_URL="postgresql://romeo:romeo_demo_only@localhost:5432/romeo?schema=public"
POSTGRES_USER=romeo
POSTGRES_PASSWORD=romeo_demo_only
POSTGRES_DB=romeo
POSTGRES_PORT=5432
# Начальные публичные настройки: seed переносит их в SalonSettings.
# Каталог и расчёт используют сохранённые значения из PostgreSQL.
SALON_NAME="РОМЕО"
SALON_ADDRESS="Москва, Большая Никитская, 22"
SALON_PHONE="+7 (495) 000-00-00"
SALON_CURRENCY="RUB"
SALON_TIMEZONE="Europe/Moscow"
SALON_COUNTRY="RU"
# Тестовый адаптер доступен только при APP_ENV=demo, PAYMENT_MODE=TEST,
# сильном серверном секрете и SalonSettings.isDemo=true.
# Для боевого окружения задайте APP_ENV=production: тестовое подтверждение запрещено.
APP_ENV=demo
PAYMENT_MODE=DISABLED
# Включение локального теста: PAYMENT_MODE=TEST и свой случайный секрет ≥32 байт.
# Генерация: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PAYMENT_WEBHOOK_SECRET=
# Начальная политика: записи, брони и тестовые платежи сохраняются; деньги не списываются.
BOOKING_HORIZON_DAYS=60
MINIMUM_LEAD_MINUTES=120
SLOT_STEP_MINUTES=30
HOLD_DURATION_MINUTES=10
BUFFER_MINUTES=15
DEMO_PREPAYMENT_MODE="PERCENTAGE"
DEMO_PREPAYMENT_FIXED_MINOR=50000
DEMO_PREPAYMENT_PERCENTAGE=25
# BOOKING_TERMS и PRIVACY_TERMS необязательны. Без них используются демо-тексты.
